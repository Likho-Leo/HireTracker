@model HireTracker.Models.Booking
@{
    ViewData["Title"] = "Delete Booking";
}

<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="Index" class="btn btn-sm btn-cancel">← Back</a>
    <h4 class="mb-0">Delete Booking</h4>
</div>

<div class="form-card" style="max-width: 600px; margin: 0 auto;">
    <div class="text-center mb-4">
        <p class="text-danger fw-bold fs-5">Are you sure you want to delete this booking?</p>
        <p class="text-muted">This action cannot be undone.</p>
    </div>

    <p class="form-section-title">BOOKING SUMMARY</p>
    <hr class="mt-0 mb-3" />

    <div class="row mb-4">
        <div class="col-md-6">
            <p class="detail-label">Company Name</p>
            <p>@Model.CompanyName</p>
        </div>
        <div class="col-md-6">
            <p class="detail-label">Route</p>
            <p>@Model.Pickup → @Model.Dropoff</p>
        </div>
        <div class="col-md-6">
            <p class="detail-label">Vehicle</p>
            <p>@Model.Vehicle</p>
        </div>
        <div class="col-md-6">
            <p class="detail-label">Passengers</p>
            <p>@Model.Passengers</p>
        </div>
        <div class="col-md-6">
            <p class="detail-label">Amount Due</p>
            <p>R @Model.AmountDue.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</p>
        </div>
        <div class="col-md-6">
            <p class="detail-label">Trip Status</p>
            <p><span class="badge-@Model.TripStatus?.ToLower()">@Model.TripStatus</span></p>
        </div>
    </div>

    <form asp-action="Delete" method="post" asp-antiforgery="true">
        <input type="hidden" asp-for="BookingId" />
        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-cancel">Cancel</a>
            <input type="submit" value="Delete" class="btn btn-delete" />
        </div>
    </form>
</div>