@model HireTracker.Models.Booking

@{
	ViewData["Title"] = "Delete booking";
}

<h4>Delete Booking</h4>
<h3>Are you sure you want to delete this booking?</h3>
<div>
	<dl>
		<dt>@Html.DisplayNameFor(model => model.CompanyName)</dt>
		<dd>@Html.DisplayFor(model => model.CompanyName)</dd>

		<dt>Route</dt>
		<dd>@Html.DisplayFor(model => model.Pickup) -> @Html.DisplayFor(model => model.Dropoff)</dd>

		<dt>@Html.DisplayNameFor(model => model.Vehicle)</dt>
		<dd>@Html.DisplayFor(model => model.Vehicle)</dd>

		<dt>@Html.DisplayNameFor(model => model.Passengers)</dt>
		<dd>@Html.DisplayFor(model => model.Passengers)</dd>

		<dt>@Html.DisplayNameFor(model => model.AmountDue)</dt>
		<dd>@Html.DisplayFor(model => model.AmountDue)</dd>

		<dt>@Html.DisplayNameFor(model => model.AmountPaid)</dt>
		<dd>@Html.DisplayFor(model => model.AmountPaid)</dd>

		<dt>@Html.DisplayNameFor(model => model.TripStatus)</dt>
		<dd>@Html.DisplayFor(model => model.TripStatus)</dd>
	</dl>

	<form asp-action="Delete" method="post" asp-antiforgery="true">
		<input type="hidden" asp-for="BookingId" />
		<input type="submit" value="Delete" class="btn"/>
		<a asp-action="Index" class="btn">Cancel</a>
	</form>
</div>
