@model HireTracker.Models.Booking

@{
	ViewData["Title"] = "Edit booking";
}

<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="Index" class="btn btn-sm btn-cancel">← Back</a>
    <h4 class="mb-0">Edit Booking</h4>
</div>

<div class="form-card">
    <form asp-action="Edit" method="post" asp-antiforgery="true">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <p class="form-section-title">TRIP DETAILS</p>
        <hr class="mt-0 mb-3" />
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <input type="hidden" asp-for="BookingId" />
                <label asp-for="Date" class="form-label">Date</label>
                <input asp-for="Date" type="date" class="form-control" />
                <span class="text-danger" asp-validation-for="Date"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ReturnDate" class="form-label">ReturnDate</label>
                <input asp-for="ReturnDate" type="date" class="form-control" />
                <span class="text-danger" asp-validation-for="ReturnDate"></span>
            </div>
            <div class="col-md-12">
                <label asp-for="Vehicle" class="form-label">Vehicle</label>
                <div id="vehicleList">
                    <div class="d-flex gap-2 mb-2 vehicle-row">
                        <select class="form-select vehicle-select" onchange="updateVehicleField()">
                            <option value="">Select vehicle</option>
                            <option value="15 seater">15 seater</option>
                            <option value="22 seater">22 seater</option>
                            <option value="70 seater">70 seater</option>
                        </select>
                        <button type="button" class="btn btn-sm btn-cancel" onclick="removeVehicle(this)">Remove</button>
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-new-booking mt-2" onclick="addVehicle()">Add vehicle</button>
                <input type="hidden" id="Vehicle" name="Vehicle" />     @*builds comma seperated string on submit*@
                <span class="text-danger" asp-validation-for="Vehicle"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Pickup" class="form-label">Pickup location</label>
                <input asp-for="Pickup" type="text" class="form-control" placeholder="Enter pickup location" />
                <span class="text-danger" asp-validation-for="Pickup"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Dropoff" class="form-label">Drop off location</label>
                <input asp-for="Dropoff" type="text" class="form-control" placeholder="Enter drop off location" />
                <span class="text-danger" asp-validation-for="Dropoff"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="TripStatus" class="form-label">Trip status</label>
                <select asp-for="TripStatus" class="form-select">
                    <option value="">Select trip status</option>
                    <option value="Completed">Completed</option>
                    <option value="Pending">Pending</option>
                </select>
                <span class="text-danger" asp-validation-for="TripStatus"></span>
            </div>
        </div>

        <p class="form-section-title">CLIENT DETAILS</p>
        <hr class="mt-0 mb-3" />
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="CompanyName" class="form-label">Company name</label>
                <input asp-for="CompanyName" type="text" class="form-control" placeholder="Enter company name" />
                <span class="text-danger" asp-validation-for="CompanyName"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ContactNumber" class="form-label">Contact number</label>
                <input asp-for="ContactNumber" type="text" class="form-control" placeholder="Enter contact number" />
                <span class="text-danger" asp-validation-for="ContactNumber"></span>
            </div>
        </div>

        <p class="form-section-title">PAYMENT DETAILS</p>
        <hr class="mt-0 mb-3" />
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="Passengers" class="form-label">Number of passengers</label>
                <input asp-for="Passengers" type="number" class="form-control" placeholder="e.g. 15" id="passengers" />
                <span class="text-danger" asp-validation-for="Passengers"></span>
            </div> 
            <div id="paymentFields">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="AmountPaid" class="form-label">Amount paid (R)</label>
                        <input asp-for="AmountPaid" type="number" class="form-control" placeholder="e.g. 0" id="AmountPaid" />
                        <span class="text-danger" asp-validation-for="AmountPaid"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PaymentStatus" class="form-label">Payment status</label>
                        <select asp-for="PaymentStatus" class="form-select" id="PaymentStatus" disabled>
                            <option value="">Select payment status</option>
                            <option value="Paid">Paid</option>
                            <option value="Partial">Partial</option>
                            <option value="Owing">Owing</option>
                        </select>
                        <input type="hidden" asp-for="PaymentStatus" id="PaymentStatusHidden" />
                        <span class="text-danger" asp-validation-for="PaymentStatus"></span>
                    </div>
                </div>
            </div>
        </div>

       <div class="col-md-6">
    <label asp-for="AmountDue" class="form-label">Amount due (R)</label>
    <input asp-for="AmountDue" type="number" class="form-control" placeholder="e.g. 1000" id="AmountDue" />
    <span class="text-danger" asp-validation-for="AmountDue"></span>
</div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-cancel">Cancel</a>
            <input type="submit" value="Update" class="btn btn-save" />
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const amountPaidInput = document.getElementById('AmountPaid');
        const paymentStatus = document.getElementById('PaymentStatus');
        const paymentStatusHidden = document.getElementById('PaymentStatusHidden')


        function autoSetPaymentStatus() {
            const amountDue = parseFloat(document.getElementById('AmountDue').value) || 0;
            const amountPaid = parseFloat(amountPaidInput.value) || 0;

            if (amountPaid >= amountDue && amountDue > 0) {
                paymentStatus.value = 'Paid';
            } else if (amountPaid > 0 && amountPaid < amountDue) {
                paymentStatus.value = 'Partial';
            } else {
                paymentStatus.value = 'Owing';
            }
            paymentStatusHidden.value = paymentStatus.value;
        }

         function addVehicle() {
            const vehicleList = document.getElementById('vehicleList');
            const row = document.createElement('div');
            row.className = 'd-flex gap-2 mb-2 vehicle-row';
            row.innerHTML = `
            <select class="form-select vehicle-select" onchange="updateVehicleField()">
                <option value="">Select vehicle</option>
                <option value="15 seater">15 seater</option>
                <option value="22 seater">22 seater</option>
                <option value="70 seater">70 seater</option>
            </select>
            <button type="button" class="btn btn-sm btn-cancel"onclick="removeVehicle(this)">Remove</button>
            `;
            vehicleList.appendChild(row);
        }

        function removeVehicle(btn) {
            const rows = document.querySelectorAll('.vehicle-row');
            if(rows.length === 1) {
                alert('At least one vehicle is required.');
                return;
            }
            btn.parentElement.remove();
            updateVehicleField();
        }

        function updateVehicleField() {
            const selects = document.querySelectorAll('.vehicle-select');
            const vehicles = [];
            selects.forEach(select => {
                if(select.value) vehicles.push(select.value);
            });
            document.getElementById('Vehicle').value = vehicles.join(', ')
        }

        // Pre-populate vehicle rows on page load
        document.addEventListener('DOMContentLoaded', function() {
            const existingVehicles = '@Model.Vehicle'.split(', ');
            const vehicleList = document.getElementById('vehicleList');

            // Clear the default empty row
            vehicleList.innerHTML = '';

            existingVehicles.forEach(vehicle => {
                const row = document.createElement('div');
                row.className = 'd-flex gap-2 mb-2 vehicle-row';
                row.innerHTML = `
                    <select class="form-select vehicle-select" onchange="updateVehicleField()">
                        <option value="">Select vehicle</option>
                        <option value="15 seater" ${vehicle === '15 seater' ? 'selected' : ''}>15 seater</option>
                        <option value="22 seater" ${vehicle === '22 seater' ? 'selected' : ''}>22 seater</option>
                        <option value="70 seater" ${vehicle === '70 seater' ? 'selected' : ''}>70 seater</option>
                    </select>
                    <button type="button" class="btn btn-sm btn-cancel" onclick="removeVehicle(this)">Remove</button>
                `;
                vehicleList.appendChild(row);
            });

            updateVehicleField();
        });

         // Event listeners
        document.getElementById('AmountDue').addEventListener('input', autoSetPaymentStatus);
        document.getElementById('AmountPaid').addEventListener('input', autoSetPaymentStatus);
        document.addEventListener('DOMContentLoaded', autoSetPaymentStatus);
    </script>
}
