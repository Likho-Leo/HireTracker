@model HireTracker.Models.Booking
@{
    ViewData["Title"] = "Create Booking";
}

<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="Index" class="btn btn-sm btn-cancel">← Back</a>
    <h4 class="mb-0">New Booking</h4>
</div>

<div class="form-card">
    <form asp-action="Create" method="post" asp-antiforgery="true">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <p class="form-section-title">TRIP DETAILS</p>
        <hr class="mt-0 mb-3" />
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="Date" class="form-label">Date</label>
                <input asp-for="Date" type="date" class="form-control" />
                <span class="text-danger" asp-validation-for="Date"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Vehicle" class="form-label">Vehicle</label>
                <select asp-for="Vehicle" class="form-select">
                    <option value="">Select vehicle</option>
                    <option value="15 seater">15 seater</option>
                    <option value="22 seater">22 seater</option>
                    <option value="65 seater">65 seater</option>
                </select>
                <span class="text-danger" asp-validation-for="Vehicle"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Pickup" class="form-label">Pickup location</label>
                <input asp-for="Pickup" type="text" class="form-control" placeholder="Enter pickup location" />
                <span class="text-danger" asp-validation-for="Pickup"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Dropoff" class="form-label">Drop off location</label>
                <input asp-for="Dropoff" type="text" class="form-control" placeholder="Enter drop off location" />
                <span class="text-danger" asp-validation-for="Dropoff"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="TripStatus" class="form-label">Trip status</label>
                <select asp-for="TripStatus" class="form-select">
                    <option value="">Select trip status</option>
                    <option value="Completed">Completed</option>
                    <option value="Pending">Pending</option>
                </select>
                <span class="text-danger" asp-validation-for="TripStatus"></span>
            </div>
        </div>

        <p class="form-section-title">CLIENT DETAILS</p>
        <hr class="mt-0 mb-3" />
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="CompanyName" class="form-label">Company name</label>
                <input asp-for="CompanyName" type="text" class="form-control" placeholder="Enter company name" />
                <span class="text-danger" asp-validation-for="CompanyName"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ContactNumber" class="form-label">Contact number</label>
                <input asp-for="ContactNumber" type="text" class="form-control" placeholder="Enter contact number" />
                <span class="text-danger" asp-validation-for="ContactNumber"></span>
            </div>
        </div>

        <p class="form-section-title">PAYMENT DETAILS</p>
        <hr class="mt-0 mb-3" />
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="Passengers" class="form-label">Number of passengers</label>
                <input asp-for="Passengers" type="number" class="form-control" placeholder="e.g. 15" id="passengers" />
                <span class="text-danger" asp-validation-for="Passengers"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="PricePerhead" class="form-label">Price per head (R)</label>
                <input asp-for="PricePerhead" type="number" class="form-control" placeholder="e.g. 50" id="pricePerHead" />
                <span class="text-danger" asp-validation-for="PricePerhead"></span>
            </div>
            <div class="col-md-12">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="notYetPaid" checked/>
                    <label class="form-check-label" for="notYetPaid">Not yet paid</label>
                </div>
            </div>
            <div id="paymentFields">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="AmountPaid" class="form-label">Amount paid (R)</label>
                        <input asp-for="AmountPaid" type="number" class="form-control" placeholder="e.g. 0" id="AmountPaid" />
                        <span class="text-danger" asp-validation-for="AmountPaid"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PaymentStatus" class="form-label">Payment status</label>
                        <select asp-for="PaymentStatus" class="form-select" id="PaymentStatus">
                            <option value="">Select payment status</option>
                            <option value="Paid">Paid</option>
                            <option value="Partial">Partial</option>
                            <option value="Owing">Owing</option>
                        </select>
                        <span class="text-danger" asp-validation-for="PaymentStatus"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="container-footer">
            <label class="form-label mb-0">Amount Due (auto calculated)</label>
            <span id="amountDue"><strong>R 0.00</strong></span>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-cancel">Cancel</a>
            <input type="submit" value="Save booking" class="btn btn-save" />
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        //define reusable function
        function calculateAmountDue() {
            /**
             * document.getElementById() finds input field by id
             * .value gets the input value
             * parseFloat() converts the text value to a decimal number
             * || 0 defaults to a 0 instead of NaN
             */

            const passengers = parseFloat(document.getElementById('passengers').value) || 0;
            const pricePerHead = parseFloat(document.getElementById('pricePerHead').value) || 0;
            const amountDue = passengers * pricePerHead;
            const amountPaid = parseFloat(document.getElementById('AmountPaid').value) || 0;

            //Find amount due by its span id and format to 2 decimal places
            document.getElementById('amountDue').innerHTML = '<strong>R ' + amountDue.toFixed(2) + '</strong>';

            //Auto set payment status
            if (!document.getElementById('notYetPaid').checked){
                const paymentStatus = document.getElementById('PaymentStatus');
                if(amountPaid >= amountDue && amountDue > 0){
                    payemntStatus.value = 'Paid';
                } else if(amountPaid > 0 && amountPaid < amountDue){
                    payemntStatus.value = 'Partial';
                } else{
                    paymentStatus.value = 'Owing';
                }
            }
        }

        document.getElementById('AmountPaid').addEventListener('input', calculateAmountDue);

        //listen for any change in the input field
        document.getElementById('passengers').addEventListener('input', calculateAmountDue);
        document.getElementById('pricePerHead').addEventListener('input', calculateAmountDue);

        const checkbox = document.getElementById('notYetPaid');
        const paymentFields = document.getElementById('paymentFields');
        const amountPaid = document.getElementById('AmountPaid');
        const paymentStatus = document.getElementById('PaymentStatus');

        function togglePaymentFields() {
            if(checkbox.checked){
                paymentFields.style.display = 'none';
                amountPaid.value = 0;
                paymentStatus.value = 'Owing';
            } else{
                paymentFields.style.display = 'block';
                amountPaid.value = '';
                paymentStatus.value = '';
            }
        }

        //run on page load
         togglePaymentFields();

         //run when chaeckbox changes
         checkbox.addEventListener('change', togglePaymentFields);
    </script>
}
