@model HireTracker.Models.Booking
@{
    ViewData["Title"] = "Create Booking";
}

<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="Index" class="btn btn-sm btn-cancel">← Back</a>
    <h4 class="mb-0">New Booking</h4>
</div>

<div class="form-card">
    <form asp-action="Create" method="post" asp-antiforgery="true" id="createForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <p class="form-section-title">TRIP DETAILS</p>
        <hr class="mt-0 mb-3" />
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="Date" class="form-label" >Date</label>
                <input asp-for="Date" type="date" class="form-control" id="Date" />
                <span class="text-danger" asp-validation-for="Date"></span>
            </div>
            <div class="col-md-6" id="returnDateField">
                <label asp-for="ReturnDate" class="form-label">Return Date</label>
                <input asp-for="ReturnDate" type="date" class="form-control" id="ReturnDate" />
                <span class="text-danger" asp-validation-for="ReturnDate" id="returnDateError"></span>
            </div>
            <div class="col-md-12">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="returnSameDay" />
                    <label class="form-check-label" for="returnSameDay">Returning same day</label>
                </div>
            </div>
            <div class="col-md-12">
                <label asp-for="Vehicle" class="form-label">Vehicle</label>
               <div id="vehicleList">
                    <div class="d-flex gap-2 mb-2 vehicle-row">
                        <select class="form-select vehicle-select" onchange="updateVehicleField()">
                            <option value="">Select vehicle</option>
                            <option value="15 seater">15 seater</option>
                            <option value="22 seater">22 seater</option>
                            <option value="70 seater">70 seater</option>
                        </select>
                        <button type="button" class="btn btn-sm btn-cancel" onclick="removeVehicle(this)">Remove</button>
                    </div>
               </div>
                <button type="button" class="btn btn-sm btn-new-booking mt-2" onclick="addVehicle()">Add vehicle</button>
                <input type="hidden" id="Vehicle" name="Vehicle" />     @*builds comma seperated string on submit*@
                <span class="text-danger" id="vehicleError" asp-validation-for="Vehicle"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Pickup" class="form-label">Pickup location</label>
                <input asp-for="Pickup" type="text" class="form-control" placeholder="Enter pickup location" />
                <span class="text-danger" asp-validation-for="Pickup"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Dropoff" class="form-label">Drop off location</label>
                <input asp-for="Dropoff" type="text" class="form-control" placeholder="Enter drop off location" />
                <span class="text-danger" asp-validation-for="Dropoff"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="TripStatus" class="form-label">Trip status</label>
                <select asp-for="TripStatus" class="form-select">
                    <option value="">Select trip status</option>
                    <option value="Completed">Completed</option>
                    <option value="Pending">Pending</option>
                </select>
                <span class="text-danger" asp-validation-for="TripStatus"></span>
            </div>
        </div>

        <p class="form-section-title">CLIENT DETAILS</p>
        <hr class="mt-0 mb-3" />
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="CompanyName" class="form-label">Company name</label>
                <input asp-for="CompanyName" type="text" class="form-control" placeholder="Enter company name" />
                <span class="text-danger" asp-validation-for="CompanyName"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ContactNumber" class="form-label">Contact number</label>
                <input asp-for="ContactNumber" type="text" class="form-control" placeholder="Enter contact number" id="ContactNumber" />
                <span class="text-danger" asp-validation-for="ContactNumber"></span>
            </div>
        </div>

        <p class="form-section-title">PAYMENT DETAILS</p>
        <hr class="mt-0 mb-3" />
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="Passengers" class="form-label">Number of passengers</label>
                <input asp-for="Passengers" type="number" class="form-control" placeholder="e.g. 15" id="passengers" />
                <span class="text-danger" asp-validation-for="Passengers"></span>
            </div>
            
            <div class="col-md-12">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="notYetPaid" />
                    <label class="form-check-label" for="notYetPaid">Not yet paid</label>
                </div>
            </div>
            <div id="paymentFields">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="AmountPaid" class="form-label">Amount paid (R)</label>
                        <input asp-for="AmountPaid" type="number" class="form-control" placeholder="e.g. 0" id="AmountPaid" />
                        <span class="text-danger" asp-validation-for="AmountPaid"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PaymentStatus" class="form-label">Payment status</label>
                        <select asp-for="PaymentStatus" class="form-select" id="PaymentStatus" disabled>
                            <option value="">Select payment status</option>
                            <option value="Paid">Paid</option>
                            <option value="Partial">Partial</option>
                            <option value="Owing">Owing</option>
                        </select>
                        <input type="hidden" asp-for="PaymentStatus" id="PaymentStatusHidden" />
                        <span class="text-danger" asp-validation-for="PaymentStatus"></span>
                    </div>
                </div>  
            </div>
            <div class="col-md-6">
                <label asp-for="AmountDue" class="form-label">Amount due (R)</label>
                <input asp-for="AmountDue" type="number" class="form-control" placeholder="e.g. 1000" id="AmountDue" />
                <span class="text-danger" asp-validation-for="AmountDue"></span>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-cancel">Cancel</a>
            <input type="submit" value="Save booking" class="btn btn-save" />
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const checkbox = document.getElementById('notYetPaid');
        const paymentFields = document.getElementById('paymentFields');
        const amountPaidInput = document.getElementById('AmountPaid');
        const paymentStatus = document.getElementById('PaymentStatus');
        const paymentStatusHidden = document.getElementById('PaymentStatusHidden');

        const capacities = {
            '15 seater': 15,
            '22 seater': 22,
            '70 seater': 70
        };

        //functions

        function autoSetPaymentStatus() {
            if (!checkbox.checked) {
                const amountDue = parseFloat(document.getElementById('AmountDue').value) || 0;
                const amountPaid = parseFloat(amountPaidInput.value) || 0;
                if (amountPaid >= amountDue && amountDue > 0) {
                    paymentStatus.value = 'Paid';
                } else if (amountPaid > 0 && amountPaid < amountDue) {
                    paymentStatus.value = 'Partial';
                } else {
                    paymentStatus.value = 'Owing';
                }
                paymentStatusHidden.value = paymentStatus.value;
            }
        }

        function togglePaymentFields() {
            if (checkbox.checked) {
                paymentFields.style.display = 'none';
                amountPaidInput.value = 0;
                paymentStatus.value = 'Owing';
                paymentStatusHidden.value = 'Owing';
            } else {
                paymentFields.style.display = 'block';
                amountPaidInput.value = '';
                paymentStatus.value = '';
                paymentStatusHidden.value = '';
            }
        }

        function addVehicle() {
            const vehicleList = document.getElementById('vehicleList');
            const row = document.createElement('div');
            row.className = 'd-flex gap-2 mb-2 vehicle-row';
            row.innerHTML = `
                <select class="form-select vehicle-select" onchange="updateVehicleField()">
                    <option value="">Select vehicle</option>
                    <option value="15 seater">15 seater</option>
                    <option value="22 seater">22 seater</option>
                    <option value="70 seater">70 seater</option>
                </select>
                <button type="button" class="btn btn-sm btn-cancel" onclick="removeVehicle(this)">Remove</button>
            `;
            vehicleList.appendChild(row);
        }

        function removeVehicle(btn) {
            const rows = document.querySelectorAll('.vehicle-row');
            if (rows.length === 1) {
                alert('At least one vehicle is required.');
                return;
            }
            btn.parentElement.remove();
            updateVehicleField();
        }

        function updateVehicleField() {
            const selects = document.querySelectorAll('.vehicle-select');
            const vehicles = [];
            selects.forEach(select => {
                if (select.value) vehicles.push(select.value);
            });
            document.getElementById('Vehicle').value = vehicles.join(', ');
            validatePassengers();
        }

        function validatePassengers() {
            const selects = document.querySelectorAll('.vehicle-select');
            const passengers = parseInt(document.getElementById('passengers').value) || 0;
            let totalCapacity = 0;

            selects.forEach(select => {
                if (select.value && capacities[select.value]) {
                    totalCapacity += capacities[select.value];
                }
            });

            const errorSpan = document.getElementById('vehicleError');
            if (totalCapacity > 0 && passengers > totalCapacity) {
                errorSpan.textContent = `Selected vehicles can only carry ${totalCapacity} passengers total.`;
            } else {
                errorSpan.textContent = '';
            }
        }

        //Event Listeners

        document.getElementById('returnSameDay').addEventListener('change', function() {
            const returnDateInput = document.getElementById('ReturnDate');
            const departureDate = document.getElementById('Date').value;
            if (this.checked) {
                returnDateInput.value = departureDate;
                document.getElementById('returnDateField').style.display = 'none';
            } else {
                returnDateInput.value = '';
                document.getElementById('returnDateField').style.display = 'block';
            }
        });

        //submit event listener
        document.getElementById('createForm').addEventListener('submit', function(e) {
            let hasError = false;

            // Passenger limit check
            const selects = document.querySelectorAll('.vehicle-select');
            const passengers = parseInt(document.getElementById('passengers').value) || 0;
            let totalCapacity = 0;
            selects.forEach(select => {
                if (select.value && capacities[select.value]) {
                    totalCapacity += capacities[select.value];
                }
            });
            if (totalCapacity > 0 && passengers > totalCapacity) {
                document.getElementById('vehicleError').textContent =
                    `Selected vehicles can only carry ${totalCapacity} passengers total.`;
                hasError = true;
            } else {
                document.getElementById('vehicleError').textContent = '';
            }

            // Return date check
            const departureDate = document.getElementById('Date').value;
            const returnDate = document.getElementById('ReturnDate').value;
            if (returnDate && returnDate < departureDate) {
                document.getElementById('returnDateError').textContent =
                    'Return date cannot be before the departure date.';
                hasError = true;
            } else {
                document.getElementById('returnDateError').textContent = '';
            }

            // Contact number check
            // const contactNumber = document.getElementById('ContactNumber').value.trim();
            // const saNumber = /^(\+27|0)[6-8][0-9]{8}$/;
            // if (contactNumber && !saNumber.test(contactNumber)) {
            //     document.getElementById('contactError').textContent =
            //         'Please enter a valid South African number e.g. 0721234567';
            //     hasError = true;
            // } else {
            //     document.getElementById('contactError').textContent = '';
            // }

            // if (hasError) {
            //     e.preventDefault();
            //     // Scroll to first error
            //     document.querySelector('.text-danger:not(:empty)')?.scrollIntoView({ behavior: 'smooth' });
            // }
        });

        // Set minimum date to today
        document.addEventListener('DOMContentLoaded', function() {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('Date').setAttribute('min', today);
        });
        
        //return date validation
        document.getElementById('ReturnDate').addEventListener('change', function() {
            const departureDate = document.getElementById('Date').value;
            const returnDate = this.value;
            const errorSpan = document.getElementById('returnDateError');

            if (departureDate && returnDate && returnDate < departureDate) {
                errorSpan.textContent = 'Return date cannot be before the departure date.';
            } else {
                errorSpan.textContent = '';
            }
        });

        document.getElementById('Date').addEventListener('change', function() {
            document.getElementById('ReturnDate').setAttribute('min', this.value);

            // Re-validate return date if it's already filled in
            const returnDate = document.getElementById('ReturnDate').value;
            if (returnDate && returnDate < this.value) {
                document.getElementById('returnDateError').textContent =
                    'Return date cannot be before the departure date.';
            } else {
                document.getElementById('returnDateError').textContent = '';
            }
        });

        // document.getElementById('ContactNumber').addEventListener('blur', function() {
        //     const value = this.value.trim();
        //     const saNumber = /^(\+27|0)[6-8][0-9]{8}$/;
        //     if (value && !saNumber.test(value)) {
        //         document.getElementById('contactError').textContent =
        //             'Please enter a valid South African number e.g. 0721234567 or +27721234567';
        //     } else {
        //         document.getElementById('contactError').textContent = '';
        //     }
        // });

        document.getElementById('passengers').addEventListener('input', validatePassengers);
        document.getElementById('AmountDue').addEventListener('input', autoSetPaymentStatus);
        document.getElementById('AmountPaid').addEventListener('input', autoSetPaymentStatus);

        togglePaymentFields();
        checkbox.addEventListener('change', togglePaymentFields);
    </script>
}
