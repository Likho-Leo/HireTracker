@model IEnumerable<HireTracker.Models.Booking>

@{
	ViewData["Title"] = "Index";
}

<div class="booking-header">
	<h4 class="booking-title">Booking</h4>
	<button class="new-booking">+ New booking</button>
</div>

<div class="booking-eyebrow">
	<div>
		<input type="text" id="searchCompanyRoute" class="form-control" placeholder="Search by company or route" onkeyup="searchTable()"/>
	</div>

	<div>
		<select id="tripsFilter" class="form-select" w-auto>
			<option value="All">All trips</option>
			<option value="Completed">Completed trips</option>
			<option value="Pending">Pendings trips</option>
		</select>
	</div>

	<div>
		<select id="paymentsFilter" class="form-select" w-auto>
			<option value="All">All payments</option>
			<option value="Completed">Completed payments</option>
			<option value="Pending">Pendings payments</option>
		</select>
	</div>

	<div>
		<select id="dateRange" class="form-select" w-auto>
			<option value="All">Date Range</option>
			<option value="1">1 month</option>
			<option value="2">3 months</option>
		</select>
	</div>
</div>

<div class="container">
	<div>
		<table class="table">
			<thead>
				<tr>
					<th>Date</th>
					<th>Route</th>
					<th>Company</th>
					<th>Vehicle</th>
					<th>Passangers</th>
					<th>Amount Due</th>
					<th>Amount Paid</th>
					<th>Trip</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				@foreach(var item in Model)
				{
					<tr>
						<td>@Html.DisplayFor(modelItem => item.Date)</td>
						<td>@item.Pickup -> @item.Dropoff</td>
						<td>@Html.DisplayFor(modelItem => item.CompanyName)</td>
						<td>@Html.DisplayFor(modelItem => item.Vehicle)</td>
						<td>@Html.DisplayFor(modelItem => item.Passengers)</td>
						<td>@Html.DisplayFor(modelItem => item.AmountDue)</td>
						<td>@Html.DisplayFor(modelItem => item.AmountPaid)</td>
						<td>@Html.DisplayFor(modelItem => item.TripStatus)</td>
						<td>
							<a asp-action="Details" asp-route-id="@item.BookingId">View</a>
							<a asp-action="Edit" asp-route-id="@item.BookingId">Edit</a>
							<a asp-action="Delete" asp-route-id="@item.BookingId">Delete</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
	
</div>


