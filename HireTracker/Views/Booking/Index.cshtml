@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<HireTracker.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Bookings</h4>
    <a asp-action="Create" class="btn btn-new-booking">+ New booking</a>
</div>

<form method="get" asp-action="Index" class="d-flex gap-2 mb-3">
    <input type="text" name="search" value="@ViewBag.Search" class="form-control"  placeholder="Search by company or route" />
    <select name="tripStatus" class="form-select w-auto">
        <option value="All" selected="@(ViewBag.TripStatus == "All" || ViewBag.TripStatus == null)">All trips</option>
        <option value="Pending" selected="@(ViewBag.TripStatus == "Pending")">Pending</option>
        <option value="Completed" selected="@(ViewBag.TripStatus == "Completed")">Completed</option>
    </select>
    <select name="paymentStatus" class="form-select w-auto">
        <option value="All" selected="@(ViewBag.PaymentStatus == "All" || ViewBag.PaymentStatus == null)">All payments</option>
        <option value="Paid" selected="@(ViewBag.PaymentStatus == "Paid")">Paid</option>
        <option value="Owing" selected="@(ViewBag.PaymentStatus == "Owing")">Owing</option>
        <option value="Partial" selected="@(ViewBag.PaymentStatus == "Partial")">Partial</option>
    </select>
    <select name="dateRange" class="form-select w-auto">
        <option value="">All time</option>
        <option value="1" selected="@(ViewBag.DateRange == 1)">Last 1 month</option>
        <option value="3" selected="@(ViewBag.DateRange == 3)">Last 3 months</option>
        <option value="6" selected="@(ViewBag.DateRange == 6)">Last 6 months</option>
    </select>
    <button type="submit" class="btn btn-new-booking">Search</button>
    <a asp-action="Index" class="btn btn-cancel">Clear</a>
</form>

<div class="table-card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr style="border-bottom: 1px solid #E0E0E0;">
                    <th>Date</th>
                    <th>Route</th>
                    <th>Company</th>
                    <th>Vehicle</th>
                    <th>Passengers</th>
                    <th>Amount Due</th>
                    @* <th>Amount Paid</th> *@
                    <th>Outstanding</th>
                    <th>Payment</th>
                    <th>Trip</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.Date.ToString("dd MMM yyyy")
                            @if (item.ReturnDate.HasValue)
                            {
                                if (item.ReturnDate.Value == item.Date)
                                {
                                    <span class="badge-return">Same day return</span>
                                }
                                else
                                {
                                    <span class="badge-return">Return: @item.ReturnDate.Value.ToString("dd MMM yyyy")</span>
                                }
                            }
                        </td>
                        <td>@item.Pickup → @item.Dropoff</td>
                        <td>@item.CompanyName</td>
                        <td>
                            @{
                                var vehicles = item.Vehicle?.Split(", ") ?? new string[0];
                                var vehicleCounts = vehicles.GroupBy(v => v)
                                .ToDictionary(g => g.Key, g => g.Count());
                                var vehicleDisplay = string.Join(", ", vehicleCounts
                                .Select(kv => kv.Value > 1 ? $"{kv.Key} x{kv.Value}" : kv.Key));
                                var uniqueVehicles = vehicleCounts.Count;
                            }

                            @if (uniqueVehicles <= 1)
                            {
                                @vehicleDisplay
                            }
                            else
                            {
                                var firstVehicle = vehicleCounts.First();
                                var firstDisplay = firstVehicle.Value > 1 ? $"{firstVehicle.Key} x{firstVehicle.Value}" : firstVehicle.Key;
                                var remaining = uniqueVehicles - 1;

                                <div class="dropdown">
                                    <span class="vehicle-summary" data-bs-toggle="dropdown" style="cursor:pointer;">
                                        @firstDisplay
                                        @if (remaining > 0)
                                        {
                                            <span>+@remaining ▼</span>
                                        }
                                    </span>
                                    <ul class="dropdown-menu">
                                        @foreach (var kv in vehicleCounts)
                                        {
                                            <li class="dropdown-item">
                                                @(kv.Value > 1 ? $"{kv.Key} x{kv.Value}" : kv.Key)
                                            </li>
                                        }
                                    </ul>
                                </div>

                            }
                        </td>
                        <td>@item.Passengers</td>
                        <td>R @item.AmountDue.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</td>
                        @* <td>R @item.AmountPaid.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</td> *@
                        <td>R @((item.AmountDue - item.AmountPaid).ToString("N2", System.Globalization.CultureInfo.InvariantCulture))</td>
                        <td><span class="badge-@item.PaymentStatus?.ToLower()">@item.PaymentStatus</span></td>
                        <td><span class="badge-@item.TripStatus.ToLower()">@item.TripStatus</span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.BookingId" class="btn btn-sm btn-view">View</a>
                            <a asp-action="Edit" asp-route-id="@item.BookingId" class="btn btn-sm btn-edit">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.BookingId" class="btn btn-sm btn-delete">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="d-flex justify-content-between align-items-center p-3 border-top">
            <span class="text-muted" style="font-size:13px;">
                Showing @Model.FirstItemOnPage - @Model.LastItemOnPage of @Model.TotalItemCount bookings
            </span>
            @Html.PagedListPager(Model, page => Url.Action("Index", new {
            page,
            search = ViewBag.Search,
            tripStatus = ViewBag.TripStatus,
            paymentStatus = ViewBag.PaymentStatus,
            dateRange = ViewBag.DateRange
                        }))
        </div>
    </div>
</div>
