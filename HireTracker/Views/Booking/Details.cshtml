@model HireTracker.Models.Booking
@{
    ViewData["Title"] = "Booking Details";
}

<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="Index" class="btn btn-sm btn-cancel">← Back</a>
    <h4 class="mb-0">Booking Details</h4>
</div>

<div class="form-card">
    <p class="form-section-title">TRIP DETAILS</p>
    <hr class="mt-0 mb-3" />
    <div class="row mb-4">
        <div class="col-md-6">
            <p class="text-muted mb-1" style="font-size:14px;">Date</p>
            <p>@Model.Date.ToString("dd MMM yyyy")</p>
        </div>
        <div class="col-md-6">
            <p class="text-muted mb-1" style="font-size:14px;">Vehicle</p>
            <p>@Model.Vehicle</p>
        </div>
        <div class="col-md-6">
            <p class="text-muted mb-1" style="font-size:14px;">Route</p>
            <p>@Model.Pickup → @Model.Dropoff</p>
        </div>
        <div class="col-md-6">
            <p class="text-muted mb-1" style="font-size:14px;">Trip Status</p>
            <p><span class="badge-@Model.TripStatus?.ToLower()">@Model.TripStatus</span></p>
        </div>
    </div>

    <p class="form-section-title">CLIENT DETAILS</p>
    <hr class="mt-0 mb-3" />
    <div class="row mb-4">
        <div class="col-md-6">
            <p class="text-muted mb-1" style="font-size:14px;">Company Name</p>
            <p>@Model.CompanyName</p>
        </div>
        <div class="col-md-6">
            <p class="text-muted mb-1" style="font-size:14px;">Contact Number</p>
            <p>@Model.ContactNumber</p>
        </div>
    </div>

    <p class="form-section-title">PAYMENT DETAILS</p>
    <hr class="mt-0 mb-3" />
    <div class="row mb-4">
        <div class="col-md-6">
            <p class="text-muted mb-1" style="font-size:14px;">Passengers</p>
            <p>@Model.Passengers</p>
        </div>
        <div class="col-md-6">
            <p class="text-muted mb-1" style="font-size:14px;">Price Per Head</p>
            <p>R @Model.PricePerhead.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</p>
        </div>
        <div class="col-md-6">
            <p class="text-muted mb-1" style="font-size:14px;">Amount Due</p>
            <p>R @Model.AmountDue.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</p>
        </div>
        <div class="col-md-6">
            <p class="text-muted mb-1" style="font-size:14px;">Amount Paid</p>
            <p>R @Model.AmountPaid.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</p>
        </div>
        <div class="col-md-6">
            <p class="text-muted mb-1" style="font-size:14px;">Payment Status</p>
            <p><span class="badge-@Model.PaymentStatus?.ToLower()">@Model.PaymentStatus</span></p>
        </div>
        <div class="col-md-6">
            <p class="text-muted mb-1" style="font-size:14px;">Created At</p>
            <p>@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</p>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Edit" asp-route-id="@Model.BookingId" class="btn btn-edit">Edit</a>
    </div>
</div>